/* Pendant V3 - Fault Overlay: Phase 2C-1 minimum blocking fault overlay */
.rc-fault-overlay-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.52);
}

.rc-fault-overlay-card {
    width: 420px;
    max-width: 92%;
    padding: 16px;
    border-radius: 12px;
    background-color: rgba(30, 30, 40, 0.98);
}

.rc-fault-overlay-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.rc-fault-overlay-button {
    min-height: 34px;
    min-width: 96px;
    margin-left: 8px;
}

.rc-fault-overlay-button--danger {
    background-color: rgba(255, 70, 70, 0.22);
}
