/* Pendant V3 - Root Shell: Phase 0B minimum shell tokens and layout */
:root {
    --rc-backdrop: rgb(18, 18, 24);
    --rc-left-rail: rgb(24, 24, 32);
    --rc-card: rgb(30, 30, 40);
    --rc-card-alt: rgb(36, 36, 48);
    --rc-accent: rgb(80, 140, 255);
    --rc-success: rgb(60, 200, 120);
    --rc-warning: rgb(255, 180, 40);
    --rc-danger: rgb(255, 70, 70);
    --rc-title-text: rgb(240, 240, 245);
    --rc-muted-text: rgb(140, 140, 160);
    --rc-top-bar-height: 56px;
    --rc-nav-rail-width: 72px;
    --rc-context-panel-width: 320px;
    --rc-bottom-bar-height: 48px;
    --rc-work-tab-height: 40px;
    --rc-gap: 4px;
    --rc-card-padding: 12px;
    --rc-radius: 6px;
}

.rc-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--rc-backdrop);
    color: var(--rc-title-text);
}

.rc-top-status-bar {
    height: var(--rc-top-bar-height);
    min-height: var(--rc-top-bar-height);
    max-height: var(--rc-top-bar-height);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    background-color: var(--rc-card-alt);
}

.rc-top-info {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.rc-top-controls {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-left: 12px;
}

.rc-probe-button {
    min-height: 30px;
    min-width: 110px;
}

.rc-top-button {
    min-height: 32px;
    min-width: 72px;
    margin-left: 6px;
}

.rc-top-button--danger {
    background-color: rgba(255, 70, 70, 0.18);
}

.rc-title {
    font-size: 20px;
    unity-font-style: bold;
}

.rc-chip-row {
    flex-direction: row;
    margin-top: 4px;
}

.rc-status-chip {
    margin-right: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 6px;
    font-size: 12px;
    background-color: var(--rc-card);
}

.rc-status-chip--muted {
    color: var(--rc-muted-text);
}

.rc-status-chip--success {
    color: var(--rc-success);
}

.rc-meta {
    font-size: 12px;
    color: var(--rc-muted-text);
}

.rc-body-row {
    flex-grow: 1;
    flex-direction: row;
    margin-top: var(--rc-gap);
    margin-bottom: var(--rc-gap);
}

.rc-nav-rail {
    width: var(--rc-nav-rail-width);
    min-width: var(--rc-nav-rail-width);
    max-width: var(--rc-nav-rail-width);
    flex-direction: column;
    background-color: var(--rc-left-rail);
    padding-top: 8px;
    padding-bottom: 8px;
}

.rc-nav-item {
    min-height: 56px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    border-radius: 6px;
    unity-text-align: middle-center;
    white-space: normal;
}

.rc-nav-item--active {
    background-color: rgba(80, 140, 255, 0.22);
}

.rc-main-content {
    flex-grow: 1;
    margin-left: var(--rc-gap);
    margin-right: var(--rc-gap);
    flex-direction: column;
}

.rc-work-tab-bar {
    height: var(--rc-work-tab-height);
    min-height: var(--rc-work-tab-height);
    max-height: var(--rc-work-tab-height);
    flex-direction: row;
    background-color: var(--rc-card-alt);
    padding-left: 8px;
    padding-right: 8px;
    align-items: center;
}

.rc-tab {
    min-height: 30px;
    margin-right: 6px;
}

.rc-main-split {
    flex-grow: 1;
    flex-direction: row;
    margin-top: var(--rc-gap);
}

.rc-work-panel {
    width: 45%;
    flex-shrink: 0;
    background-color: var(--rc-card);
    border-radius: var(--rc-radius);
    padding: var(--rc-card-padding);
}

.rc-viewport-host {
    flex-grow: 1;
    margin-left: var(--rc-gap);
    background-color: rgb(10, 10, 14);
    border-radius: var(--rc-radius);
    padding: var(--rc-card-padding);
}

.rc-context-panel {
    width: var(--rc-context-panel-width);
    min-width: var(--rc-context-panel-width);
    max-width: var(--rc-context-panel-width);
    flex-direction: column;
}

.rc-context-card {
    background-color: var(--rc-card);
    border-radius: var(--rc-radius);
    padding: var(--rc-card-padding);
    margin-bottom: var(--rc-gap);
}

.rc-context-flex {
    flex-grow: 1;
}

.rc-panel-title {
    font-size: 17px;
    unity-font-style: bold;
}

.rc-panel-copy {
    margin-top: 6px;
    font-size: 14px;
    color: var(--rc-muted-text);
    white-space: normal;
}

.rc-bottom-bar {
    height: var(--rc-bottom-bar-height);
    min-height: var(--rc-bottom-bar-height);
    max-height: var(--rc-bottom-bar-height);
    flex-direction: row;
    align-items: center;
    background-color: var(--rc-card-alt);
    padding-left: 12px;
    padding-right: 12px;
}

.rc-bottom-button {
    min-width: 72px;
    min-height: 32px;
    margin-right: 6px;
}

.rc-speed-slider {
    flex-grow: 1;
    margin-left: 12px;
}

.rc-speed-value {
    min-width: 36px;
    margin-left: 8px;
    font-size: 14px;
    color: var(--rc-muted-text);
}

.rc-popup-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.0);
}

.rc-popup-card {
    min-width: 360px;
    max-width: 420px;
    padding: 16px;
    border-radius: 12px;
    background-color: var(--rc-card-alt);
}

.rc-popup-action-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.rc-popup-button {
    min-width: 88px;
    min-height: 36px;
    margin-left: 8px;
}

.rc-popup-button--primary {
    background-color: var(--rc-accent);
    color: var(--rc-title-text);
}

.rc-hidden {
    display: none;
}

.rc-popup-layer--active {
    background-color: rgba(0, 0, 0, 0.6);
}

.rc-popup-placeholder {
    margin-right: 12px;
    margin-bottom: 56px;
    font-size: 12px;
    color: var(--rc-muted-text);
}
