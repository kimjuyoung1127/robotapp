/* Pendant V3 - Easy Motion: Phase 2B-1 preset poses and gripper shortcuts */
.rc-easy-root {
    flex-grow: 1;
    flex-direction: column;
}

.rc-easy-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.rc-easy-badge {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 999px;
    background-color: rgba(60, 200, 120, 0.16);
    color: var(--rc-success);
    font-size: 12px;
}

.rc-easy-section-title {
    margin-top: 12px;
    font-size: 12px;
    color: var(--rc-muted-text);
    -unity-font-style: bold;
}

.rc-easy-section-title--spaced {
    margin-top: 16px;
}

.rc-easy-preset-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.rc-easy-preset-button {
    width: 48%;
    min-width: 132px;
    min-height: 88px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: rgba(36, 36, 48, 0.96);
}

.rc-easy-gripper-row {
    flex-direction: row;
    margin-top: 8px;
}

.rc-easy-option-card {
    margin-top: 14px;
    padding: 12px;
    border-radius: 10px;
    background-color: rgba(18, 18, 24, 0.55);
}

.rc-easy-hint {
    margin-top: 6px;
    font-size: 13px;
    color: var(--rc-muted-text);
}

.rc-easy-exec-row {
    flex-direction: row;
    margin-top: 12px;
}

.rc-easy-action-button {
    flex-grow: 1;
    min-height: 44px;
    margin-right: 8px;
}

.rc-easy-action-button--primary {
    background-color: rgba(60, 200, 120, 0.18);
}

.rc-easy-action-button--danger {
    background-color: rgba(255, 70, 70, 0.18);
}
