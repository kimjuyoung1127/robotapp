/* Pendant V3 - Safety Diagnostics: Phase 2C-1 minimum safety/diagnostics panel */
.rc-safety-root {
    margin-bottom: var(--rc-gap);
}

.rc-safety-banner {
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: 6px;
}

.rc-safety-banner--safe {
    background-color: rgba(60, 200, 120, 0.14);
}

.rc-safety-banner--warning {
    background-color: rgba(255, 180, 40, 0.14);
}

.rc-safety-banner--danger {
    background-color: rgba(255, 70, 70, 0.18);
}

.rc-safety-banner-text {
    font-size: 13px;
    -unity-font-style: bold;
}

.rc-safety-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.rc-safety-chip {
    margin-right: 6px;
    margin-bottom: 4px;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 12px;
    background-color: rgba(255, 255, 255, 0.06);
}

.rc-safety-chip--safe {
    color: var(--rc-success);
}

.rc-safety-chip--warning {
    color: var(--rc-warning);
}

.rc-safety-chip--danger {
    color: var(--rc-danger);
}

.rc-safety-chip--muted {
    color: var(--rc-muted-text);
}

.rc-safety-recovery-card {
    margin-top: 10px;
    padding: 10px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.04);
}

.rc-safety-event-card {
    margin-top: 10px;
    padding: 10px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.04);
}

.rc-safety-subtitle {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--rc-title-text);
}

.rc-safety-action {
    margin-top: 8px;
    min-height: 32px;
}

.rc-safety-event-line {
    margin-top: 4px;
    font-size: 12px;
    color: var(--rc-muted-text);
}
