.rc-point-root {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
}

.rc-point-header {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    min-width: 0;
}

.rc-point-motion-row {
    flex-direction: row;
    flex-wrap: wrap;
    min-width: 0;
}

.rc-point-motion-button {
    min-width: 56px;
    min-height: 30px;
    margin-left: 6px;
    margin-bottom: 4px;
}

.rc-point-motion-button--active {
    background-color: rgba(80, 140, 255, 0.22);
}

.rc-point-name-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 10px;
    min-width: 0;
}

.rc-point-name-label {
    min-width: 72px;
    font-size: 14px;
    color: var(--rc-muted-text);
}

.rc-point-name-input {
    flex-grow: 1;
    min-width: 120px;
    min-height: 32px;
}

.rc-point-name-input--danger {
    background-color: rgba(255, 70, 70, 0.16);
}

.rc-point-coord-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
    min-width: 0;
}

.rc-point-coord-button {
    min-width: 56px;
    min-height: 30px;
    margin-right: 6px;
    margin-bottom: 4px;
}

.rc-point-coord-button--active {
    background-color: rgba(80, 140, 255, 0.22);
}

.rc-point-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
}

.rc-point-cell {
    flex-grow: 1;
    width: 46%;
    min-width: 92px;
    min-height: 44px;
    flex-direction: row;
    align-items: center;
    margin-right: 6px;
    margin-bottom: 6px;
    padding: 6px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.03);
}

.rc-point-cell-label {
    min-width: 24px;
    font-size: 12px;
    -unity-font-style: bold;
}

.rc-point-cell-input {
    flex-grow: 1;
    min-width: 42px;
    min-height: 28px;
    margin-left: 4px;
    margin-right: 4px;
}

.rc-point-cell-input--danger {
    background-color: rgba(255, 70, 70, 0.16);
}

.rc-point-cell-unit {
    min-width: 22px;
    font-size: 10px;
    color: var(--rc-muted-text);
}

.rc-point-footer-card {
    margin-top: 8px;
    padding: 8px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.03);
    min-width: 0;
    max-width: 100%;
}

.rc-point-list {
    flex-direction: column;
    flex-wrap: nowrap;
    margin-top: 6px;
    min-width: 0;
    max-width: 100%;
}

.rc-point-list-button {
    flex-grow: 0;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    min-height: 28px;
    margin-right: 0;
    margin-bottom: 4px;
    font-size: 10px;
    overflow: hidden;
}

.rc-point-list-button--active {
    background-color: rgba(80, 140, 255, 0.22);
}

.rc-point-action-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-top: 12px;
}

.rc-point-action-button {
    flex-grow: 1;
    min-width: 58px;
    max-width: 100%;
    min-height: 34px;
    margin-left: 0;
    margin-right: 4px;
    margin-bottom: 6px;
    font-size: 11px;
}

.rc-point-action-button--primary {
    background-color: rgba(80, 140, 255, 0.22);
}

.rc-point-action-button--danger {
    background-color: rgba(255, 70, 70, 0.18);
}
