/* Pendant V3 - Workspace Boundary: Phase 2C-2 boundary/collision style tokens */
.rc-workspace-toggle {
    border-width: 1px;
    border-color: rgba(80, 140, 255, 0.2);
}

.rc-workspace-toggle--active {
    border-color: rgba(80, 140, 255, 0.5);
    background-color: rgba(80, 140, 255, 0.2);
}

.rc-collision-toggle--active {
    border-color: rgba(255, 70, 70, 0.52);
    background-color: rgba(255, 70, 70, 0.2);
}
