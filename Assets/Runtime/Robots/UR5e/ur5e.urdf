      <mass value="3.7"/>
      <inertia ixx="0.010267" ixy="0" ixz="0" iyy="0.010267" iyz="0" izz="0.00666"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry>
        <mesh filename="meshes/shoulder.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry>
        <mesh filename="meshes/shoulder.dae"/>
      </geometry>
    </collision>
  </link>

  <link name="upper_arm_link">
    <inertial>
      <origin xyz="-0.2125 0 0.138" rpy="0 0 0"/>
      <mass value="8.393"/>
      <inertia ixx="0.22689" ixy="0" ixz="0" iyy="0.22689" iyz="0" izz="0.0151074"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.138" rpy="1.5707963267948966 0 -1.5707963267948966"/>
      <geometry>
        <mesh filename="meshes/upperarm.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.138" rpy="1.5707963267948966 0 -1.5707963267948966"/>
      <geometry>
        <mesh filename="meshes/upperarm.dae"/>
      </geometry>
    </collision>
  </link>

  <link name="forearm_link">
    <inertial>
      <origin xyz="-0.1961 0 0.007" rpy="0 0 0"/>
      <mass value="2.275"/>
      <inertia ixx="0.049443" ixy="0" ixz="0" iyy="0.049443" iyz="0" izz="0.004095"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.007" rpy="1.5707963267948966 0 -1.5707963267948966"/>
      <geometry>
        <mesh filename="meshes/forearm.dae"/>
