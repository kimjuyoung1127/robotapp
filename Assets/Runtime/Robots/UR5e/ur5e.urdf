<?xml version="1.0" encoding="utf-8"?>
<!-- UR5e plain URDF for KineTutor3D Unity import.
     Generated from Universal_Robots_ROS2_Description config/ur5e/ official parameters.
     Joint origins from default_kinematics.yaml, mesh offsets from visual_parameters.yaml. -->
<robot name="ur5e">

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.00443333" ixy="0" ixz="0" iyy="0.00443333" iyz="0" izz="0.0072"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry>
        <mesh filename="meshes/base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry>
        <mesh filename="meshes/base.dae"/>
      </geometry>
    </collision>
  </link>

  <link name="shoulder_link">
