    <collision>
      <origin xyz="0 0 0.007" rpy="1.5707963267948966 0 -1.5707963267948966"/>
      <geometry>
        <mesh filename="meshes/forearm.dae"/>
      </geometry>
    </collision>
  </link>

  <link name="wrist_1_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.219"/>
      <inertia ixx="0.111173" ixy="0" ixz="0" iyy="0.111173" iyz="0" izz="0.21942"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.127" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <mesh filename="meshes/wrist1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.127" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <mesh filename="meshes/wrist1.dae"/>
      </geometry>
    </collision>
  </link>

  <link name="wrist_2_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.219"/>
      <inertia ixx="0.111173" ixy="0" ixz="0" iyy="0.111173" iyz="0" izz="0.21942"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0997" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wrist2.dae"/>
      </geometry>
