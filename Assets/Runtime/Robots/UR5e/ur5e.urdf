      <geometry>
        <mesh filename="meshes/wrist3.dae"/>
      </geometry>
    </collision>
  </link>

  <!-- J1: base_link -> shoulder_link -->
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.1625" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="150.0" velocity="3.14"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <!-- J2: shoulder_link -> upper_arm_link (roll pi/2) -->
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="150.0" velocity="3.14"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <!-- J3: upper_arm_link -> forearm_link -->
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="-0.425 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="150.0" velocity="3.14"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <!-- J4: forearm_link -> wrist_1_link -->
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="-0.3922 0 0.1333" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="28.0" velocity="3.14"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <!-- J5: wrist_1_link -> wrist_2_link (roll pi/2) -->
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 -0.0997 0" rpy="1.5707963267948966 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="28.0" velocity="3.14"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <!-- J6: wrist_2_link -> wrist_3_link (roll pi/2, pitch pi, yaw pi) -->
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0.0996 0" rpy="1.5707963267948966 3.141592653589793 3.141592653589793"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="28.0" velocity="3.14"/>
    <dynamics damping="0" friction="0"/>
  </joint>

</robot>
