<?xml version="1.0" encoding="utf-8"?>
<!-- Meca500 R3 plain URDF for KineTutor3D Unity import.
     Joint origins from myersjm/mecademic-ros2 community URDF.
     Gripper links removed for RobotControl use. -->
<robot name="meca500">

  <link name="meca_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_base.dae"/>
      </geometry>
    </collision>
  </link>

  <link name="meca_axis_1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_j1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_j1.dae"/>
      </geometry>
    </collision>
  </link>

  <link name="meca_axis_2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_j2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_j2.dae"/>
      </geometry>
    </collision>
  </link>

  <link name="meca_axis_3_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_j3.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_j3.dae"/>
      </geometry>
    </collision>
  </link>

  <link name="meca_axis_4_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_j4.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_j4.dae"/>
      </geometry>
    </collision>
  </link>

  <link name="meca_axis_5_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_j5.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_j5.dae"/>
      </geometry>
    </collision>
  </link>

  <link name="meca_axis_6_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_j6.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/meca_500_r3_j6.dae"/>
      </geometry>
    </collision>
  </link>

  <!-- J1: base -> axis_1, z-axis, d1=0.091 (+ x offset 0.012498 from URDF) -->
  <joint name="meca_axis_1_joint" type="revolute">
    <parent link="meca_base_link"/>
    <child link="meca_axis_1_link"/>
    <origin xyz="0.012498 0 0.091" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.05433" upper="3.05433" effort="10.0" velocity="2.618"/>
  </joint>

  <!-- J2: axis_1 -> axis_2, y-axis, d2=0.044 -->
  <joint name="meca_axis_2_joint" type="revolute">
    <parent link="meca_axis_1_link"/>
    <child link="meca_axis_2_link"/>
    <origin xyz="0 0 0.044" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.22173" upper="1.5708" effort="10.0" velocity="2.618"/>
  </joint>

  <!-- J3: axis_2 -> axis_3, y-axis, a3=0.135 -->
  <joint name="meca_axis_3_joint" type="revolute">
    <parent link="meca_axis_2_link"/>
    <child link="meca_axis_3_link"/>
    <origin xyz="0 0 0.135" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.35619" upper="1.22173" effort="10.0" velocity="3.142"/>
  </joint>

  <!-- J4: axis_3 -> axis_4, x-axis, d4=0.038 -->
  <joint name="meca_axis_4_joint" type="revolute">
    <parent link="meca_axis_3_link"/>
    <child link="meca_axis_4_link"/>
    <origin xyz="0 0 0.038" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.96706" upper="2.96706" effort="10.0" velocity="5.236"/>
  </joint>

  <!-- J5: axis_4 -> axis_5, y-axis, a5=0.120 -->
  <joint name="meca_axis_5_joint" type="revolute">
    <parent link="meca_axis_4_link"/>
    <child link="meca_axis_5_link"/>
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.00713" upper="2.00713" effort="10.0" velocity="5.236"/>
  </joint>

  <!-- J6: axis_5 -> axis_6, x-axis, a6=0.070 -->
  <joint name="meca_axis_6_joint" type="revolute">
    <parent link="meca_axis_5_link"/>
    <child link="meca_axis_6_link"/>
    <origin xyz="0.07 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="8.727"/>
  </joint>

</robot>
